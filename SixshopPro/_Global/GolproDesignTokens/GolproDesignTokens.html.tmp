<style>
:root{
  /* === GOLPRO Design Tokens v1 === */
  /* Space scale */
  --gp-space-1:4px;--gp-space-2:8px;--gp-space-3:12px;--gp-space-4:16px;--gp-space-5:20px;--gp-space-6:24px;--gp-space-8:32px;--gp-space-10:40px;--gp-space-12:48px;--gp-space-16:64px;--gp-space-20:80px;
  /* Brand colors */
  --gp-color-accent:{{property.accentColor}};--gp-color-accent-hover:{{property.accentHoverColor}};--gp-color-accent-soft:{{property.accentSoftColor}};--gp-color-gold:{{property.goldColor}};--gp-color-gold-soft:{{property.goldSoftColor}};
  /* Neutral palette */
  --gp-color-neutral-50:#FAFAF8;--gp-color-neutral-100:#F5F5F5;--gp-color-neutral-200:#E5E5E5;--gp-color-neutral-300:#D4D4D4;--gp-color-neutral-400:#A3A3A3;--gp-color-neutral-500:#737373;--gp-color-neutral-600:#525252;--gp-color-neutral-700:#404040;--gp-color-neutral-800:#262626;--gp-color-neutral-900:#111111;
  /* Semantic colors */
  --gp-color-bg:{{property.bgColor}};--gp-color-surface:{{property.surfaceColor}};--gp-color-border:{{property.borderColor}};--gp-color-divider:#F0F0F0;
  --gp-color-text-primary:#111111;--gp-color-text-secondary:#525252;--gp-color-text-muted:#737373;
  --gp-color-success:#1A7A50;--gp-color-warning:#C89B3C;--gp-color-danger:#B33A3A;
  /* Typography */
  --gp-font-family-heading:{{property.fontFamilyHeading}};--gp-font-family-body:{{property.fontFamilyBody}};
  --gp-font-size-xs:11px;--gp-font-size-sm:12px;--gp-font-size-base:14px;--gp-font-size-md:15px;--gp-font-size-lg:16px;--gp-font-size-xl:18px;--gp-font-size-2xl:22px;--gp-font-size-3xl:28px;--gp-font-size-4xl:36px;--gp-font-size-display:48px;
  --gp-font-weight-regular:400;--gp-font-weight-medium:500;--gp-font-weight-semibold:600;--gp-font-weight-bold:700;--gp-font-weight-black:900;
  --gp-line-height-tight:1.2;--gp-line-height-base:1.5;--gp-line-height-relaxed:1.75;
  --gp-letter-spacing-tight:-0.02em;--gp-letter-spacing-normal:0;--gp-letter-spacing-wide:0.05em;--gp-letter-spacing-wider:0.1em;
  /* Radius */
  --gp-radius-sm:4px;--gp-radius-md:8px;--gp-radius-lg:12px;--gp-radius-xl:16px;--gp-radius-2xl:24px;--gp-radius-full:9999px;
  /* Shadow */
  --gp-shadow-xs:0 1px 2px rgba(0,0,0,0.04);
  --gp-shadow-sm:0 2px 4px rgba(0,0,0,0.06),0 1px 2px rgba(0,0,0,0.04);
  --gp-shadow-md:0 4px 8px rgba(0,0,0,0.08),0 2px 4px rgba(0,0,0,0.04);
  --gp-shadow-lg:0 8px 16px rgba(0,0,0,0.10),0 4px 8px rgba(0,0,0,0.06);
  --gp-shadow-xl:0 16px 32px rgba(0,0,0,0.12),0 8px 16px rgba(0,0,0,0.08);
  --gp-shadow-card-hover:0 8px 24px rgba(0,0,0,0.09);
  /* Transitions */
  --gp-duration-fast:180ms;--gp-duration-base:260ms;--gp-duration-slow:420ms;
  --gp-ease-standard:cubic-bezier(0.22,1,0.36,1);--gp-ease-emphasized:cubic-bezier(0.25,0.1,0.25,1);--gp-ease-bounce:cubic-bezier(0.34,1.56,0.64,1);
  /* Z-index */
  --gp-z-dropdown:100;--gp-z-sticky:200;--gp-z-fixed:300;--gp-z-modal-backdrop:400;--gp-z-modal:500;--gp-z-popover:600;--gp-z-tooltip:700;
}
.gpDesignTokensRoot{display:none !important;}
</style>
<template>
<div class="gpDesignTokensRoot" aria-hidden="true" data-gp-tokens="v1"></div>
</template>
<script>
(function(){
  try {
    if (typeof console !== 'undefined' && console.info) {
      console.info('[GOLPRO Design Tokens v1] loaded — accent: ' + ({{property.developerMode}} || false ? '{{property.accentColor}}' : 'hidden'));
    }
  } catch(e) {}
})();
</script>